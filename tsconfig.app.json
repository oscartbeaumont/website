{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "ES2022",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "filesystem-routing/types"],
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",

		/* Linting */
		"strict": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	},
	"include": ["src", ".cloudflare/types"],
	/* The image generators build React elements for the Rust renderer, which is
	   not the JSX the rest of the project compiles, so they are checked by
	   running them instead. */
	"exclude": ["src/generate-og.tsx", "src/generate-addy-icons.tsx"]
}
